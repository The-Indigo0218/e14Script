# Copia este archivo como .env y pon tu clave. NO subas .env al repo.
#
# Reproducir el proyecto: ver README.md → "Guía de reproducción"
#   cp .env.example .env
#   python probar_api.py
#   python leer_testigos.py datos/testigos/21_01_13_testigo.pdf actas.db --tipo claveros --solo-pagina-1
#
# Motor OCR (opcional). Vacío = autodetecta por clave disponible: gemini | gpt | openrouter | manual
OCR_BACKEND=gemini

# Detección de copias en foto del testigo con Gemini (gasta 1 llamada EXTRA por acta).
# Dejar vacío o 0 = solo heurística offline (ahorra cuota).
# OCR_DETECTAR_COPIAS_GEMINI=0

# Doble lectura con GPT cuando Gemini reporta confianza < 80% en alguna casilla
# (requiere también OPENAI_API_KEY puesta abajo). Solo gasta la llamada extra
# en las casillas dudosas, no en cada acta. Dejar vacío o 0 = desactivado.
# OCR_VERIFICAR_BAJA_CONFIANZA=0

# ── Gemini (recomendado) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── GPT / OpenAI (verificador opcional) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── OpenRouter (alternativa con saldo prepago, cuando facturar directo con el
#    proveedor del modelo no es viable, ej. problemas con Google Cloud Billing) ──
# Verificá el slug exacto del modelo en https://openrouter.ai/models antes de
# usar — el de abajo es una suposición, puede no coincidir.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash
