# Copia este archivo como .env y pon tu clave. NO subas .env al repo.
#
# Elige el motor de OCR (opcional). Si lo dejas vacío, se autodetecta según
# qué clave esté disponible. Valores: gemini | gpt | manual
OCR_BACKEND=gemini

# ── Gemini (recomendado) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── GPT / OpenAI (verificador opcional) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
